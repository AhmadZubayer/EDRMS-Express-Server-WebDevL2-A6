model CommunityPost {
  id        String     @id @default(uuid())
  title     String
  body      String     @db.Text
  mediaUrls String[]
  status    PostStatus @default(POSTED)
  bumpedAt  DateTime   @default(now())
  isDeleted Boolean    @default(false)
  deletedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  CommunityPostComment[]
  reactions CommunityPostReaction[]
  reports   CommunityPostReport[]

  @@index([authorId])
  @@index([status])
  @@map("community_posts")
}

model CommunityPostComment {
  id      String @id @default(uuid())
  content String @db.Text

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@map("community_post_comments")
}

model CommunityPostReaction {
  id   String       @id @default(uuid())
  type ReactionType @default(LIKE)

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId])
  @@index([userId])
  @@map("community_post_reactions")
}

model CommunityPostReport {
  id     String @id @default(uuid())
  reason String @db.Text

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([reporterId])
  @@map("community_post_reports")
}
