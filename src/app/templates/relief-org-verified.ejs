<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Relief Organization Verified</title>
    <style>
      body { font-family: Arial, sans-serif; background: #f7f7f7; color: #333; }
      .container { max-width: 500px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
      .footer { margin-top: 30px; font-size: 12px; color: #888; }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>Your organization is verified</h2>
      <p>Hello <%= name %>,</p>
      <p>Great news! <strong><%= organizationName %></strong> has been verified by an administrator on <%= appName %>.</p>
      <p>You can now create shelters and manage relief operations for active disasters.</p>
      <div class="footer">&copy; <%= appName %>. All rights reserved.</div>
    </div>
  </body>
</html>
