<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Admin account created</title>
    <style>
      body { font-family: Arial, sans-serif; background: #f7f7f7; color: #333; }
      .container { max-width: 500px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
      .credentials { background: #f0f4ff; border-radius: 6px; padding: 14px 18px; margin: 20px 0; font-family: monospace; font-size: 15px; line-height: 1.8; }
      .footer { margin-top: 30px; font-size: 12px; color: #888; }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>Welcome to <%= appName %>, <%= name %>!</h2>
      <p>An administrator has created <%= typeof accountLabel !== "undefined" ? accountLabel : "an administrator account" %> for you on <%= appName %>.</p>
      <div class="credentials">
        Email: <%= email %><br />
        Temporary password: <%= password %>
      </div>
      <p>For your security you will be asked to change this password after your first login. Please do not share it with anyone.</p>
      <% if (typeof loginUrl !== "undefined" && loginUrl) { %>
      <p>Log in here: <a href="<%= loginUrl %>"><%= loginUrl %></a></p>
      <% } %>
      <div class="footer">&copy; <%= appName %>. All rights reserved.</div>
    </div>
  </body>
</html>
